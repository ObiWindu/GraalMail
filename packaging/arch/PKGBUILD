pkgname=graalmail
pkgver=0.1.0
pkgrel=1
pkgdesc="Mail client for Gmail, Outlook, Yahoo, Proton Mail and IMAP"
arch=('x86_64' 'aarch64')
url="https://github.com/graalmail/graalmail"
license=('Apache-2.0')
depends=('gtk3' 'libxtst' 'libxrender')
if [ "$CARCH" = "x86_64" ]; then
  _arch=amd64
else
  _arch=arm64
fi
source=("graalmail-${pkgver}-linux-${_arch}.tar.gz")
sha256sums=('SKIP')

prepare() {
  # The release archive contains the self contained application image.
  tar -xzf "graalmail-${pkgver}-linux-${_arch}.tar.gz"
}

package() {
  # Install application files to /opt/graalmail
  install -d "$pkgdir/opt/graalmail"
  cp -a "$srcdir/GraalMail/." "$pkgdir/opt/graalmail/"

  # Install desktop entry
  install -d "$pkgdir/usr/share/applications"
  cat > "$pkgdir/usr/share/applications/graalmail.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Version=1.0
Name=GraalMail
GenericName=Mail Client
Comment=Read and send mail with Gmail, Outlook, Yahoo, Proton Mail and generic IMAP accounts
Exec=GraalMail %u
Icon=graalmail
Terminal=false
Categories=Network;Email;
Keywords=mail;email;imap;smtp;
StartupWMClass=GraalMail
EOF

  # Install icon
  install -Dm644 "$srcdir/GraalMail/lib/GraalMail.png" \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/graalmail.png"

  # Create symlink in /usr/bin
  install -d "$pkgdir/usr/bin"
  ln -s /opt/graalmail/bin/GraalMail "$pkgdir/usr/bin/graalmail"
}
