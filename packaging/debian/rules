#!/usr/bin/make -f
# Licensed under the Apache License, Version 2.0 (ObiWindu <Obi.wandu@proton.me>)

export DH_VERBOSE = 1

%:
	dh $@

override_dh_auto_clean:
	rm -rf build

override_dh_auto_build:
	# The Gradle distribution zip is supplied next to the debian/ directory.
	unzip -o graalmail-$(DEB_VERSION_UPSTREAM).zip -d build

override_dh_auto_test:
	# The tests are run by Gradle before the source package is created.
	true

override_dh_auto_install:
	install -d debian/graalmail/opt/graalmail
	cp -a build/graalmail/. debian/graalmail/opt/graalmail/
	install -Dm644 graalmail.desktop debian/graalmail/usr/share/applications/graalmail.desktop
	install -Dm644 graalmail.png debian/graalmail/usr/share/icons/hicolor/256x256/apps/graalmail.png
	install -d debian/graalmail/usr/bin
	ln -s /opt/graalmail/bin/graalmail debian/graalmail/usr/bin/graalmail

override_dh_strip:
	# Do not strip jars or the Java launcher.
	true

override_dh_shlibdeps:
	# The application ships its own JVM-related libraries as jar resources.
	true
