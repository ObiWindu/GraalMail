<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.GraalMail" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">@color/primary_container_light</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container_light</item>
        <item name="colorPrimaryDark">@color/brand_primary_dark</item>
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">@color/secondary_container_light</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container_light</item>
        <item name="colorTertiary">#6D4BA0</item>
        <item name="colorSurface">@color/surface_light</item>
        <item name="colorSurfaceVariant">@color/surface_variant_light</item>
        <item name="colorOnSurface">@color/text_primary_light</item>
        <item name="colorOnSurfaceVariant">@color/text_variant_light</item>
        <item name="colorOutline">@color/outline_light</item>
        <item name="colorSurfaceContainer">@color/surface_container_light</item>
        <item name="colorSurfaceContainerLow">@color/surface_light</item>
        <item name="colorSurfaceContainerHigh">@color/surface_variant_light</item>
        <item name="colorOutlineVariant">@color/outline_variant_light</item>
        <item name="colorAccent">@color/brand_accent</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorSurface</item>
        <item name="android:navigationBarColor" tools:targetApi="l">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:windowBackground">?attr/colorSurface</item>
    </style>

    <style name="Theme.GraalMail.Dialog" parent="Theme.Material3.DayNight.Dialog" />

    <style name="TextAppearance.GraalMail.Subject" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.GraalMail.Unread" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.GraalMail.Snippet" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>

    <style name="Widget.GraalMail.Toolbar" parent="Widget.Material3.Toolbar.Surface">
        <item name="android:background">?attr/colorSurface</item>
        <item name="titleTextColor">?attr/colorOnSurface</item>
        <item name="subtitleTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:minHeight">?attr/actionBarSize</item>
    </style>

    <style name="Widget.GraalMail.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.GraalMail.OutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.GraalMail.TextButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TextAppearance.GraalMail.Caption" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>

    <style name="TextAppearance.GraalMail.Account" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.GraalMail.Button" parent="TextAppearance.Material3.LabelLarge" />

    <style name="TextAppearance.GraalMail.Folder" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
</resources>
