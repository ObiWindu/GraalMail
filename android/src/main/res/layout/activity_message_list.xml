<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mailbox_drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            style="@style/Widget.GraalMail.Toolbar"
            app:navigationIcon="@drawable/ic_menu"
            app:navigationContentDescription="@string/mailbox_open_navigation" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="false"
            android:scrollbars="none">
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/message_filters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/space_3"
                android:paddingEnd="@dimen/space_3"
                android:paddingBottom="@dimen/space_1"
                app:singleSelection="false">
                <com.google.android.material.chip.Chip
                    android:id="@+id/filter_unread"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_target_min"
                    android:checkable="true"
                    android:text="@string/message_list_unread_indicator" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/filter_starred"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_target_min"
                    android:checkable="true"
                    android:text="@string/message_list_filter_starred" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/filter_attachments"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_target_min"
                    android:checkable="true"
                    android:text="@string/message_list_filter_attachments" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/filter_clear"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_target_min"
                    android:text="@string/message_list_clear_filters"
                    android:visibility="gone" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>
    </com.google.android.material.appbar.AppBarLayout>

    <com.graalmail.android.ui.AdaptiveFrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:contentMaxWidth="@dimen/message_content_max_width"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/message_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/list_bottom_inset" />
    </com.graalmail.android.ui.AdaptiveFrameLayout>

    <TextView
        android:id="@+id/message_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="@dimen/space_5"
        android:text="@string/message_list_empty"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/message_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone"
        android:contentDescription="@string/message_list_loading">

        <ProgressBar
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:indeterminate="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_3"
            android:text="@string/message_list_loading" />
    </LinearLayout>

    <TextView
        android:id="@+id/message_offline_notice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceVariant"
        android:gravity="center"
        android:padding="@dimen/space_2"
        android:text="@string/message_list_offline_notice"
        android:textAppearance="@style/TextAppearance.GraalMail.Snippet"
        android:visibility="gone" />

    <TextView
        android:id="@+id/message_paging_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="@dimen/fab_offset"
        android:background="?attr/colorSurfaceContainerHigh"
        android:paddingHorizontal="@dimen/space_4"
        android:paddingVertical="@dimen/space_2"
        android:textAppearance="@style/TextAppearance.GraalMail.Snippet"
        android:visibility="gone" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/message_compose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/space_4"
        android:contentDescription="@string/compose_title"
        android:src="@drawable/ic_compose" />

    <androidx.appcompat.widget.ActionBarContainer
        android:id="@+id/action_mode_bar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:visibility="gone">

        <androidx.appcompat.widget.ActionBarContextView
            android:id="@+id/action_mode"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </androidx.appcompat.widget.ActionBarContainer>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <include
        android:id="@+id/mailbox_drawer_content"
        layout="@layout/view_mailbox_drawer"
        android:layout_gravity="start" />

</androidx.drawerlayout.widget.DrawerLayout>
