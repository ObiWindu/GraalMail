<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/mailbox_account_row_min"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="?android:attr/selectableItemBackground"
    android:paddingStart="@dimen/list_row_inset"
    android:paddingTop="@dimen/space_2"
    android:paddingEnd="@dimen/space_1"
    android:paddingBottom="@dimen/space_2">

    <TextView
        android:id="@+id/account_avatar"
        android:layout_width="@dimen/message_avatar_size"
        android:layout_height="@dimen/message_avatar_size"
        android:layout_marginEnd="@dimen/space_3"
        android:background="@drawable/avatar_circle"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/account_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.GraalMail.Account" />

    <ImageButton
        android:id="@+id/account_expand"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="@dimen/space_3"
        android:src="@drawable/ic_expand"
        android:tint="?attr/colorOnSurfaceVariant"
        android:contentDescription="@string/mailbox_collapse_account"
        android:scaleType="centerInside" />
</LinearLayout>
