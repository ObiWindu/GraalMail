<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            app:navigationIcon="@android:drawable/ic_menu_revert" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <Spinner
                android:id="@+id/setup_provider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />

            <EditText
                android:id="@+id/setup_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/setup_email"
                android:inputType="textEmailAddress" />

            <EditText
                android:id="@+id/setup_display_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/setup_display_name"
                android:inputType="text" />

            <EditText
                android:id="@+id/setup_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/setup_password"
                android:inputType="textPassword" />

            <LinearLayout
                android:id="@+id/setup_generic_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/setup_imap_host"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/setup_imap_host"
                    android:inputType="textUri" />

                <EditText
                    android:id="@+id/setup_imap_port"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/setup_imap_port"
                    android:inputType="number"
                    android:text="993" />

                <EditText
                    android:id="@+id/setup_smtp_host"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/setup_smtp_host"
                    android:inputType="textUri" />

                <EditText
                    android:id="@+id/setup_smtp_port"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/setup_smtp_port"
                    android:inputType="number"
                    android:text="465" />
            </LinearLayout>

            <TextView
                android:id="@+id/setup_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textAppearance="@style/TextAppearance.GraalMail.Snippet" />

            <Button
                android:id="@+id/setup_connect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/setup_connect" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
