<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            style="@style/Widget.GraalMail.Toolbar"
            app:navigationIcon="@drawable/ic_arrow_back" />
    </com.google.android.material.appbar.AppBarLayout>

    <com.graalmail.android.ui.AdaptiveFrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:contentMaxWidth="@dimen/message_content_max_width">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/reader_page_inset">

            <TextView
                android:id="@+id/view_subject"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Material3.TitleLarge" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/view_avatar"
                    android:layout_width="@dimen/message_avatar_size"
                    android:layout_height="@dimen/message_avatar_size"
                    android:layout_marginEnd="@dimen/space_3"
                    android:background="@drawable/avatar_circle"
                    android:gravity="center"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/view_from"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/view_to"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.GraalMail.Snippet" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/view_recipient_details_toggle"
                style="@style/Widget.GraalMail.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target_min"
                android:text="@string/message_view_show_details" />

            <TextView
                android:id="@+id/view_cc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:id="@+id/view_bcc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:id="@+id/view_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:textAppearance="@style/TextAppearance.GraalMail.Snippet" />

            <TextView
                android:id="@+id/view_remote_images_notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="?attr/colorSurfaceVariant"
                android:padding="@dimen/space_3"
                android:text="@string/message_view_remote_images_blocked"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/view_load_remote_images"
                style="@style/Widget.GraalMail.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target_min"
                android:text="@string/message_view_load_remote_images"
                android:visibility="gone" />

            <TextView
                android:id="@+id/view_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textIsSelectable="true" />

            <LinearLayout
                android:id="@+id/view_attachments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/view_attachment_count"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/view_no_attachments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/message_view_no_attachments"
                    android:textAppearance="@style/TextAppearance.GraalMail.Snippet"
                    android:visibility="gone" />
            </LinearLayout>
          </LinearLayout>
        </ScrollView>
    </com.graalmail.android.ui.AdaptiveFrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_2"
        android:paddingBottom="@dimen/space_2">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/message_reply"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            style="@style/Widget.GraalMail.OutlinedButton"
            android:layout_margin="@dimen/space_2"
            android:layout_weight="1"
            android:text="@string/action_reply" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/message_forward"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            style="@style/Widget.GraalMail.Button"
            android:layout_margin="@dimen/space_2"
            android:layout_weight="1"
            android:text="@string/action_forward" />
    </LinearLayout>

</LinearLayout>
